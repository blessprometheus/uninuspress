# Docker Compose environment
# Salin ke .env lalu sesuaikan.

APP_URL=https://press.uninus.ac.id
FRONTEND_URL=https://press.uninus.ac.id
APP_HTTP_PORT=80

# PostgreSQL
DB_DATABASE=uninus_press
DB_USERNAME=postgres
DB_PASSWORD=ganti-ini

# Laravel
APP_KEY=
APP_DEBUG=false
LOG_CHANNEL=stack
LOG_LEVEL=warning

# Wasabi S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=uninus-press
AWS_ENDPOINT=https://s3.ap-southeast-1.wasabisys.com

# Admin awal (dibuat oleh DatabaseSeeder)
ADMIN_EMAIL=admin@uninus.ac.id
ADMIN_PASSWORD=ganti-ini