# Database
POSTGRES_USER=press
POSTGRES_PASSWORD=ganti-password-kuat
POSTGRES_DB=uninus_press
# Dipakai Prisma saat jalan di luar Docker (sesuaikan user/password/db di atas)
DATABASE_URL=postgresql://press:ganti-password-kuat@localhost:5432/uninus_press?schema=public

# Backend
JWT_SECRET=ganti-dengan-secret-panjang-acak
PORT=3001
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Mail (SMTP)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=no-reply@uninus.ac.id
MAIL_PASSWORD=ganti-password
MAIL_FROM="Uninus Press" <no-reply@uninus.ac.id>

# S3 wasabi
S3_REGION=ap-southeast-1
S3_ENDPOINT=https://s3.ap-southeast-1.wasabisys.com
S3_BUCKET=uninus-press
S3_ACCESS_KEY_ID=ganti-access-key
S3_SECRET_ACCESS_KEY=ganti-secret-key