// Uninus Press — Prisma schema
// Nama model menggunakan kata tunggal (convention Prisma).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enum ----------

enum Role {
  ADMIN
  EDITOR
  AUTHOR
}

enum ManuscriptStatus {
  DRAFT
  SUBMITTED
  REVIEW
  ACCEPTED
  REJECTED
  IN_PRODUCTION
  PUBLISHED
}

// ---------- Users & Auth ----------

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  name            String
  role            Role      @default(AUTHOR)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  manuscripts         Manuscript[]
  emailVerifications  EmailVerification[]
  passwordResets      PasswordResetToken[]
}

model EmailVerification {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------- Manuscript (Pengajuan Naskah) ----------

model Manuscript {
  id            String            @id @default(uuid())
  userId        String
  title         String
  description   String
  status        ManuscriptStatus  @default(DRAFT)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user      User                    @relation(fields: [userId], references: [id])
  files     ManuscriptFile[]
  history   ManuscriptStatusHistory[]

  @@index([userId])
  @@index([status])
}

model ManuscriptFile {
  id          String   @id @default(uuid())
  manuscriptId String
  type        FileType
  originalName String
  key         String // object key di S3
  mimeType    String
  size        Int
  verified    Boolean  @default(false)
  verifiedById String?
  verifiedAt  DateTime?
  createdAt   DateTime @default(now())

  manuscript Manuscript @relation(fields: [manuscriptId], references: [id])

  @@index([manuscriptId])
}

enum FileType {
  MANUSCRIPT
  COVER
  PROPOSAL
}

enum BookStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model ManuscriptStatusHistory {
  id           String           @id @default(uuid())
  manuscriptId String
  from         ManuscriptStatus?
  to           ManuscriptStatus
  changedById  String?
  note         String?
  createdAt    DateTime         @default(now())

  manuscript Manuscript @relation(fields: [manuscriptId], references: [id])

  @@index([manuscriptId])
}

// ---------- CMS (Konten Halaman) ----------

model CmsPage {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  content   String // disimpan sebagai HTML/markdown dari editor admin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id          String   @id @default(uuid())
  title       String
  description String
  icon        String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Package {
  id          String   @id @default(uuid())
  name        String
  description String
  price       Decimal
  features    String[] // daftar fitur paket
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------- Toko Buku (Katalog + link eksternal) ----------

model Book {
  id          String     @id @default(uuid())
  title       String
  author      String
  description String
  coverKey    String? // object key sampul di S3
  externalUrl String? // link bookstore/Tokopedia
  published   Boolean    @default(false)
  status      BookStatus @default(DRAFT)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([published])
  @@index([status])
}

// ---------- Kontak ----------

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
